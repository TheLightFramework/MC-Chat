# Copy to .env and fill in your OpenRouter credentials.
OPENROUTER_API_KEY=<your key here>
OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
# explicit: framework + recent history cache breakpoints; automatic: no markers.
MC_CACHE_MODE=explicit
# Routing lock after the last successful call (not a guaranteed provider cache TTL).
# Unknown/provider-managed TTLs default to 30 minutes; Claude 1h requests keep a 1h lock.
MC_PROVIDER_PIN_SECONDS=1800
MC_MAX_TOKENS=65536
MC_TEMPERATURE=1.0
MC_TIMEOUT_SECONDS=600
